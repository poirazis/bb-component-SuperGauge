{
  "type": "component",
  "metadata": {},
  "schema": {
    "name": "bb-component-SuperGauge",
    "friendlyName": "Super Charts - Gauge",
    "description": "A Gauge component for Budibase",
    "icon": "GraphDonut",
    "styles": ["size", "border", "padding"],
    "settings": [
      {
        "type": "select",
        "key": "arcSize",
        "label": "Arc Size",
        "options": [
          { "label": "90 Degress", "value": "90" },
          { "label": "180 Degress", "value": "180" },
          { "label": "240 Degress", "value": "240" },
          { "label": "270 Degress", "value": "270" },
          { "label": "360 Degress", "value": "360" }
        ],
        "defaultValue": "240"
      },
      {
        "type": "text",
        "key": "min",
        "label": "Minimum",
        "placeholder": "0"
      },
      {
        "type": "text",
        "key": "max",
        "label": "Maximum",
        "placeholder": 100
      },
      {
        "type": "text",
        "key": "value",
        "label": "Value",
        "placeholder": 35
      },
      {
        "type": "text",
        "key": "valueSuffix",
        "label": "Value Suffix",
        "placeholder": "%"
      },
      {
        "type": "number",
        "key": "precision",
        "label": "Decimal Precision",
        "min": 0,
        "max": 4,
        "defaultValue": 2
      },
      {
        "type": "boolean",
        "key": "showValue",
        "label": "Show Value",
        "defaultValue": true
      },
      {
        "type": "boolean",
        "key": "showTicks",
        "label": "Show Ticks",
        "defaultValue": false
      },
      {
        "section": true,
        "tag": "style",
        "name": "Color Settings",
        "dependsOn": "showAdvanced",
        "settings": [
          {
            "type": "color",
            "key": "valueColor",
            "label": "Value Color"
          },
          {
            "type": "color",
            "key": "trackColor",
            "label": "Track Border"
          },
          {
            "type": "color",
            "key": "trackBackdropColor",
            "label": "Track Backdrop",
            "defaultValue": "var(--spectrum-global-color-gray-50)"
          },
          {
            "type": "color",
            "key": "trackFillColor",
            "label": "Track Fill ",
            "defaultValue": "var(--spectrum-global-color-blue-400)"
          },
          {
            "type": "color",
            "key": "trackGradientColor",
            "label": "Track Gradient"
          },
          {
            "type": "select",
            "key": "animationType",
            "label": "Animation",
            "options": [
              { "label": "None", "value": "none" },
              { "label": "Spring", "value": "spring" },
              { "label": "Tweened", "value": "tweened" }
            ],
            "defaultValue": "tweened"
          },
          {
            "type": "select",
            "key": "trackSize",
            "label": "Track Size",
            "options": [
              { "label": "Tiny", "value": "tiny" },
              { "label": "Small", "value": "small" },
              { "label": "Medium", "value": "medium" },
              { "label": "Large", "value": "large" },
              { "label": "Huge", "value": "huge" }
            ],
            "defaultValue": "medium"
          },
          {
            "type": "select",
            "key": "valueSize",
            "label": "Value Size",
            "options": [
              { "label": "Small", "value": "S" },
              { "label": "Medium", "value": "M" },
              { "label": "Large", "value": "L" }
            ],
            "defaultValue": "M"
          }
        ]
      },
      {
        "section": true,
        "name": "Tick Settings",
        "dependsOn": "showTicks",
        "settings": [
          {
            "type": "boolean",
            "key": "showTickLabels",
            "label": "Show Tick Labels",
            "defaultValue": false
          },
          {
            "type": "color",
            "key": "tickLabelColor",
            "label": "Tick Label Color"
          },
          {
            "type": "number",
            "key": "majorTicks",
            "label": "Major Ticks",
            "defaultValue": 10,
            "min": 1
          }
        ]
      }
    ]
  }
}
